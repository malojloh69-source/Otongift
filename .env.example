# Python server. All balances and prizes in this version are virtual.
HOST=0.0.0.0
PORT=3000
DEMO_MODE=true
DATABASE_PATH=data/game.sqlite3

# Telegram: set DEMO_MODE=false to require verified Telegram identity.
# A bot token alone does not enable real money or NFT transfers.
BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=https://your-domain.example
RUN_BOT_POLLING=false
ENABLE_STAR_PAYMENTS=false
TERMS_URL=https://your-domain.example/terms.html
SUPPORT_CONTACT=@your_support

# In production: DEMO_MODE=false, BOT_TOKEN, HTTPS MINI_APP_URL,
# RUN_BOT_POLLING=true and ENABLE_STAR_PAYMENTS=true.
# 1 XTR is charged for 100 virtual game Stars. TON Connect is read-only.

# Private secret for admin activation, no ID list required. At least 10 characters.
# For the exact /ClezzyKryt command, set this to ClezzyKryt in Bothost (a publicly
# known code grants access to anyone who sends it; a unique secret is safer).
ADMIN_ACCESS_CODE=

# Optional legacy admin IDs; leave empty when using ADMIN_ACCESS_CODE.
ADMIN_IDS=
